{
  "name": "me3",
  "version": "0.1.1",
  "private": true,
  "description": "Personal OS and AI assistant",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @me3-core/worker --filter @me3/web dev",
    "dev:fresh": "node scripts/dev-fresh.mjs",
    "dev:worker": "pnpm --filter @me3-core/worker dev",
    "dev:web": "pnpm --filter @me3/web dev",
    "init:cloudflare": "node scripts/init-cloudflare.mjs",
    "uninstall:cloudflare": "node scripts/uninstall-cloudflare.mjs",
    "destroy:cloudflare": "node scripts/uninstall-cloudflare.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "eval:agent": "node --import tsx scripts/evaluate-agent.mjs",
    "eval:memory": "node --import tsx scripts/evaluate-memory-extraction.mjs",
    "eval:web-research": "node --import tsx scripts/evaluate-web-research.mjs",
    "update:check": "node scripts/check-updates.mjs",
    "release:check": "node scripts/check-release-metadata.mjs",
    "release:check:test": "node --test scripts/check-release-metadata.test.mjs",
    "update:core": "node scripts/update-core.mjs",
    "update:doctor": "node scripts/update-doctor.mjs",
    "deploy:prepare": "node scripts/prepare-cloudflare-deploy.mjs",
    "setup:dev-vars": "node scripts/create-dev-vars.mjs",
    "storage:r2:provision": "node scripts/provision-r2.mjs",
    "portable:export": "node scripts/portable.mjs export",
    "portable:restore": "node scripts/portable.mjs restore",
    "portable:verify": "node scripts/portable.mjs verify",
    "portable:compare": "node scripts/portable.mjs compare",
    "portable:proof": "node scripts/portable.mjs proof",
    "portable:test": "node --test scripts/portable-v1.test.mjs",
    "move-restore:test": "node --test scripts/move-restore.test.mjs",
    "move:rehearsal": "node scripts/move-rehearsal.mjs",
    "update-core:test": "node --test scripts/update-core-workflow.test.mjs scripts/update-core-copied-base.test.mjs",
    "managed-install:test": "node --test scripts/attach-managed-custom-domain.test.mjs scripts/configure-managed-install.test.mjs scripts/managed-install-workflow-callback.test.mjs scripts/provision-managed-queues.test.mjs scripts/verify-managed-cloudflare-placement.test.mjs",
    "managed-upgrade:test": "node --test scripts/managed-upgrade-recovery.test.mjs scripts/configure-managed-upgrade-origin.test.mjs scripts/managed-upgrade-contract.test.mjs scripts/managed-upgrade-workflow-callback.test.mjs scripts/managed-upgrade-workflow.test.mjs scripts/verify-managed-upgrade-config.test.mjs scripts/verify-managed-upgrade-release.test.mjs scripts/verify-managed-upgrade-resources.test.mjs scripts/verify-managed-upgrade-runtime.test.mjs",
    "managed-resource:audit": "node scripts/audit-managed-cloudflare-resources.mjs",
    "managed-resource-audit:test": "node --test scripts/audit-managed-cloudflare-resources.test.mjs scripts/managed-cloudflare-resource-audit-workflow.test.mjs",
    "verify:local-boot": "node scripts/verify-local-boot.mjs",
    "demo:truhealth": "node --import tsx scripts/seed-truhealth-demo.ts",
    "build": "pnpm generate:llms && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrations:apply": "node scripts/prepare-d1-migrations.mjs && wrangler d1 migrations apply DB --remote --config wrangler.toml",
    "deploy": "pnpm db:migrations:apply && wrangler deploy --config wrangler.toml",
    "deploy:cloudflare": "pnpm deploy:prepare && pnpm build && pnpm db:migrations:apply && wrangler deploy --config wrangler.toml",
    "deploy:cloudflare:d1-only": "pnpm deploy:cloudflare",
    "deploy:cloudflare:with-r2": "pnpm deploy:prepare -- --with-r2 && pnpm build && pnpm db:migrations:apply && wrangler deploy --config wrangler.toml",
    "perf:check": "node scripts/perf-check.mjs"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "ME3 stores owner data, settings, and plugin state here. Use + Create new for a new install; Cloudflare provisions the D1 database automatically."
      },
      "ME3_USER_AGENT": {
        "description": "Durable Object coordination for mailbox events and installation cleanup. Cloudflare provisions this automatically."
      },
      "ME3_AGENT": {
        "description": "Durable execution for ME3 owner chat. Portable conversation, approval and receipt state stays in D1."
      },
      "AI": {
        "description": "Workers AI binding used by ME3's default assistant and voice features. You can add other model providers inside ME3 later."
      }
    }
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": "3.0.8",
      "brace-expansion": "2.1.4",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "hono@<4.13.13": "4.13.13"
    }
  }
}
